# Copy to ../.env (not committed) and adjust if needed

# Model/index artifacts
AIE_RAG_ARTIFACTS_DIR=artifacts
AIE_RAG_KB_PATH=data/knowledge_base.json

# Retrieval params (used during indexing; runtime uses metadata from artifacts)
AIE_RAG_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
AIE_RAG_CHUNK_SIZE=320
AIE_RAG_CHUNK_OVERLAP=60

# Service
AIE_RAG_LOG_LEVEL=INFO
